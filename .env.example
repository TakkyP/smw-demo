# ---------- MongoDB ----------
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net
MONGODB_DB=worklist

# ---------- Firebase (client / public) ----------
# Firebase console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project

# ---------- Firebase Admin (server only) ----------
# Firebase console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
# Keep the quotes; \n is converted to real newlines at runtime
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Usernames are mapped to Firebase emails as <username>@<this domain>
NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=worklist.local

# ---------- Optional: local Firebase Auth emulator ----------
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Seed first admin (npm run seed:admin) ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=ผู้ดูแลระบบ
